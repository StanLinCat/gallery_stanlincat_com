---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import path from 'path';
import { SITE } from '../site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const { BASE_URL } = import.meta.env;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Pages without their own photo share SITE.shareImage instead
async function defaultShareImage(): Promise<string | undefined> {
  const photos = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/photos/*.{jpg,jpeg,png,webp}',
    { eager: true },
  );
  const photo = photos[`../assets/photos/${SITE.shareImage}`]?.default;
  if (!photo) return undefined;
  const resized = await getImage({ src: photo, width: 1200, format: 'jpg' });
  return new URL(resized.src, Astro.site).href;
}
const ogImage = image ?? (await defaultShareImage());
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={path.join(BASE_URL, 'sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    {
      SITE.cloudflareAnalyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: SITE.cloudflareAnalyticsToken,
          })}
        />
      )
    }
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href={path.join(BASE_URL, 'favicon-96x96.png')}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={path.join(BASE_URL, 'favicon.svg')}
    />
    <link rel="shortcut icon" href={path.join(BASE_URL, 'favicon.ico')} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={path.join(BASE_URL, 'apple-touch-icon.png')}
    />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="manifest" href={path.join(BASE_URL, 'site.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Dark-first theme init — respect stored preference, else default dark
      (function () {
        const root = document.documentElement;
        const stored =
          typeof localStorage !== 'undefined'
            ? localStorage.getItem('theme')
            : null;
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';

        root.classList.toggle('dark', theme === 'dark');
        root.classList.toggle('light', theme === 'light');
        root.style.colorScheme = theme;
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem('theme', theme);
        }
      })();
    </script>
    <style>
      /* Custom styles for masonry layout */
      .masonry-container {
        column-gap: 1.5rem;
      }
      .masonry-item {
        display: inline-block;
        width: 100%;
      }
    </style>
    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-paper font-sans text-ink antialiased transition-colors duration-300"
    transition:animate="initial"
  >
    <div class="fixed top-6 right-6 z-20">
      <ThemeToggle />
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer
      class="mt-16 bg-paper-2 py-8"
      transition:name="footer"
    >
      <div
        class="container mx-auto px-6 text-center text-sm font-light text-muted"
      >
        <p>
          Photos &copy; {year}{' '}
          <a href={SITE.githubUrl} class="transition-colors hover:text-accent">
            {SITE.author}
          </a>
          . All rights reserved.
        </p>
        <nav class="mt-2" aria-label="Site">
          <a
            href={path.join(BASE_URL, 'about')}
            class="transition-colors hover:text-accent">About</a
          >
          {' · '}
          <a
            href={path.join(BASE_URL, 'copyright')}
            class="transition-colors hover:text-accent">Copyright</a
          >
          {' · '}
          <a href={SITE.blogUrl} class="transition-colors hover:text-accent"
            >Blog</a
          >
          {
            SITE.supportUrl && (
              <>
                {' · '}
                <a
                  href={SITE.supportUrl}
                  rel="noopener"
                  class="transition-colors hover:text-accent"
                >
                  Buy me a coffee
                </a>
              </>
            )
          }
        </nav>
        <p class="mt-2">
          {'Theme: '}
          <a
            href="https://github.com/EmaSuriano/astro-frame-shift"
            class="transition-colors hover:text-accent"
          >
            Astro Frame Shift
          </a>
          {' · Built with '}
          <a
            href="https://astro.build"
            class="transition-colors hover:text-accent"
          >
            Astro
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
