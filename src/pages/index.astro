---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import GalleryMasonry from '../components/GalleryMasonry.astro';
import { categoriesOf } from '../utils/categories';
import { SITE } from '../site';

const collection = await getCollection('gallery');
// Newest photos first
const images = collection
  .map((a) => ({ ...a.data, id: a.id }))
  .sort((a, b) => b.date.localeCompare(a.date));
const allCategories = [
  ...new Set(images.flatMap((img) => categoriesOf(img))),
].sort((a, b) => a.localeCompare(b));
---

<Layout title={`${SITE.name} — ${SITE.tagline}`}>
  <div class="container mx-auto px-6 py-16">
    <h1
      class="font-display mb-8 text-5xl font-normal tracking-wide text-ink"
    >
      Gallery
    </h1>

    <CategoryFilters categories={allCategories} active="all" />
    <GalleryMasonry images={images} />
  </div>
</Layout>

